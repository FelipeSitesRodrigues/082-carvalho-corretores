# Carvalho Corretores (082) - variáveis de ambiente
# Copie para .env.local. Este arquivo de exemplo vai pro Git; o .env.local não.

# Endereço público do site, sem barra no fim. Entra no canonical, no sitemap e
# no Open Graph.
NEXT_PUBLIC_SITE_URL=https://carvalho-corretores.vercel.app

# Enquanto o site for demonstração (telefone e CRECI de exemplo), ele NÃO deve
# ser indexado. Trocar para true só quando os dados reais do Marcos entrarem.
NEXT_PUBLIC_INDEXAR=false

# ---------------------------------------------------------------------------
# Supabase (ainda não configurado)
# Com as duas linhas vazias o site usa os imóveis de demonstração de
# src/lib/dados/demo.ts. Preenchidas, ele passa a ler do banco sem mudar nada
# nas páginas. As duas chaves são públicas por design: a segurança está nas RLS
# da migration em supabase/migrations/. A SERVICE_ROLE_KEY não entra aqui.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
